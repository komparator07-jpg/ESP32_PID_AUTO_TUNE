// =============================== API ===============================
void pidInit() {
  pinMode(HEATER_PIN, OUTPUT);
  heaterWrite(false);
  analogReadResolution(12);
  analogSetPinAttenuation(NTC_PIN, ADC_11db);

  for (int i = 0; i < 20; i++) { tempUpdate(); delay(TEMP_SAMPLE_MS + 2); }   // прогрев фильтра

  pidMode = PID_OFF;
  pidSpIndex = 0;
  pidSetpoint = SETPOINTS[0];
  pidOutput = 0;
}

// выбрать уставку 0..3 (во время автокалибровки игнорируется)
void pidSelectSetpoint(int i) {
  if (i < 0 || i > 3 || pidMode == PID_AUTOTUNE) return;
  pidSpIndex = i;
  pidSetpoint = SETPOINTS[i];
  pidReset();
}

void pidStart() {
  if (pidMode == PID_AUTOTUNE) return;
  pidReset();
  pidMode = PID_RUN;
}

void pidStop() {
  if (pidMode == PID_AUTOTUNE) return;
  pidMode = PID_OFF;
  pidOutput = 0;
}

void pidAutotuneStart() {
  for (int i = 0; i < 4; i++) atOrder[i] = i;
  for (int i = 1; i < 4; i++) {                       // сортировка уставок по возрастанию
    int key = atOrder[i], j = i - 1;
    while (j >= 0 && SETPOINTS[atOrder[j]] > SETPOINTS[key]) { atOrder[j + 1] = atOrder[j]; j--; }
    atOrder[j + 1] = key;
  }
  atPos = 0;
  atState = AT_RUNNING;
  atMessage = "running";
  pidMode = PID_AUTOTUNE;
  atBegin();
}

void pidAutotuneAbort() {
  if (pidMode != PID_AUTOTUNE) return;
  pidMode = PID_OFF;
  pidOutput = 0;
  atState = AT_IDLE;
  atMessage = "aborted";
}

bool pidIsCalibrated(int i) { return (i >= 0 && i < 4) && pidCalibrated[i]; }

// вызывать в loop() как можно чаще, без delay()
void pidUpdate() {
  static unsigned long tPid = 0;
  tempUpdate();

  unsigned long now = millis();
  if (now - tPid >= PID_PERIOD_MS) {
    float dt = (now - tPid) / 1000.0f;
    if (dt > 1.0f) dt = PID_PERIOD_MS / 1000.0f;      // первый вызов / большая пауза
    tPid = now;

    if (!pidSensorOk) pidOutput = 0;
    else if (pidMode == PID_RUN) pidCompute(dt);
    else if (pidMode == PID_AUTOTUNE) autotuneStep();
    else pidOutput = 0;

#if PID_DEBUG_PLOT
    debugPlotUpdate();
#endif
  }
  heaterUpdate();
}

// ============================== ПРИМЕР ==============================
void setup() {
  Serial.begin(115200);
  pidInit();
  if (!pidLoadCalibration()) Serial.println("Калибровки нет: отправьте 'a' для автокалибровки");
}

void loop() {
  pidUpdate();

  // Команды из монитора порта (замените на кнопки/меню проекта):
  // 1..4 - выбрать уставку, g - старт ПИД, s - стоп, a - автокалибровка, x - прервать
  if (Serial.available()) {
    char c = Serial.read();
    if (c >= '1' && c <= '4') pidSelectSetpoint(c - '1');
    else if (c == 'g') pidStart();
    else if (c == 's') pidStop();
    else if (c == 'a') pidAutotuneStart();
    else if (c == 'x') pidAutotuneAbort();
  }

  // Сообщение о завершении автокалибровки (один раз)
  static AtState lastAt = AT_IDLE;
  if (atState != lastAt) {
    lastAt = atState;
    if (atState == AT_DONE)   Serial.println("Автокалибровка завершена");
    if (atState == AT_FAILED) Serial.println(atMessage);
  }
}
